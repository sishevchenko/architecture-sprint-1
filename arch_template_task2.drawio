        <mxCell id="i3S1q7VI6cQmsiIeCpgI-596" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Предоставить статус платежа&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];rounded=1;rotation=-90;" parent="1" vertex="1" connectable="0">
