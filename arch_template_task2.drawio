        </mxCell>
        <mxCell id="i3S1q7VI6cQmsiIeCpgI-372" value="Сервис аукциона" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=20;container=0;" parent="1" vertex="1">
